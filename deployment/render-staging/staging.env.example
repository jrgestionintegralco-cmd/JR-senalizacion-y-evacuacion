# New staging credentials only; never copy the current Cloud .env.
# Runtime normally receives the INTERNAL URL through the Blueprint.
DATABASE_URL=postgresql://staging_app:REPLACE_NEW_PASSWORD@REPLACE_STAGING_HOST:5432/safe_enter_render_staging
WEB_ORIGIN=https://REPLACE_SERVICE.onrender.com
COOKIE_SECURE=true
API_PORT=4000
PORT=10000
# Required by existing config, but no storage service is deployed.
S3_ENDPOINT=http://127.0.0.1:9
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9
S3_REGION=us-east-1
S3_BUCKET=staging-storage-disabled
S3_ACCESS_KEY=storage-disabled
S3_SECRET_KEY=storage-disabled-not-a-real-secret
S3_FORCE_PATH_STYLE=true
SESSION_TTL_HOURS=8
# Manual initialization only, from a trusted machine using the external DB URL.
CONFIRM_RENDER_STAGING=safe_enter_render_staging
STAGING_REVIEWER_EMAIL=REPLACE_WITH_TEST_EMAIL
STAGING_REVIEWER_PASSWORD=REPLACE_WITH_NEW_TEST_PASSWORD
